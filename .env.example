# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ
PORT=3000
JWT_SECRET=เปลี่ยนเป็นข้อความลับของคุณ
JWT_EXPIRES=12h

# ---------- PostgreSQL ----------
# วิธีที่ 1 : ใส่ connection string เส้นเดียว (ถ้ามีค่านี้ จะใช้ค่านี้ก่อน)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/espresso_flow

# วิธีที่ 2 : แยกเป็นตัวแปร (ใช้เมื่อไม่ได้ตั้ง DATABASE_URL)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=espresso_flow

# ต่อผ่าน SSL (เช่น Neon / Supabase / Render) ให้ตั้งเป็น true
# PGSSL=false
# จำนวน connection สูงสุดใน pool
# PGPOOL_MAX=10
# timezone ที่ใช้กับ LOCALTIMESTAMP / CURRENT_DATE
# DB_TIMEZONE=Asia/Bangkok

# ---------- ตรวจสลิปโอนเงิน (ไม่บังคับ) ----------
# ถ้าไม่ตั้ง : ระบบอ่าน QR บนสลิปเพื่อกันสลิปซ้ำ แล้วให้พนักงานยืนยันยอดเอง
# เลือกผู้ให้บริการ : easyslip หรือ slipok
# SLIP_PROVIDER=easyslip
# EASYSLIP_API_KEY=                 # https://developer.easyslip.com
# SLIPOK_API_KEY=                   # https://slipok.com
# SLIPOK_BRANCH_ID=
# ปฏิเสธสลิปที่เก่ากว่ากี่ชั่วโมง (ค่าเริ่มต้น 24)
# SLIP_MAX_AGE_HOURS=24

# ---------- LINE Bot แจ้งลูกค้าเมื่อเครื่องดื่มพร้อม (ไม่บังคับ) ----------
# LINE Developers Console → Messaging API channel
#   Basic settings → Channel secret
#   Messaging API  → Channel access token (long-lived)
# แล้วตั้ง Webhook URL เป็น https://<โดเมนของร้าน>/api/line/webhook และเปิด "Use webhook"
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
