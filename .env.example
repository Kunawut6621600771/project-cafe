# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ
PORT=3000
JWT_SECRET=เปลี่ยนเป็นข้อความลับของคุณ
JWT_EXPIRES=12h

# ---------- PostgreSQL ----------
# วิธีที่ 1 : ใส่ connection string เส้นเดียว (ถ้ามีค่านี้ จะใช้ค่านี้ก่อน)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/espresso_flow

# วิธีที่ 2 : แยกเป็นตัวแปร (ใช้เมื่อไม่ได้ตั้ง DATABASE_URL)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=espresso_flow

# ต่อผ่าน SSL (เช่น Neon / Supabase / Render) ให้ตั้งเป็น true
# PGSSL=false
# จำนวน connection สูงสุดใน pool
# PGPOOL_MAX=10
# timezone ที่ใช้กับ LOCALTIMESTAMP / CURRENT_DATE
# DB_TIMEZONE=Asia/Bangkok
